@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Риск-аналитик" as RA
boundary "ЭкранМетодики" as UI
control "СервисМетодики" as T
entity "ВерсияМетодики" as M
actor "Руководитель отдела" as HD
entity "ЖурналАудита" as AU
RA -> UI : отправить на утверждение
UI -> T : отправить(версия)
T -> T : проверитьМетрики() [есть проверка, Gini не ниже действующей]
alt метрик нет или Gini ниже
  T --> UI : ошибка
else можно отправить
  T -> M : setСтатус(На утверждении)
end
HD -> UI : утвердить или отклонить с причиной
UI -> T : утвердить(версия, решение, комментарий)
alt отклонено
  T -> M : setСтатус(Отклонена) [с причиной]
else утверждено
  T -> M : setСтатус(Утверждена) [кто и когда]
end
RA -> UI : опубликовать
UI -> T : опубликовать(версия)
T -> M : вАрхив(текущая опубликованная)
T -> M : setСтатус(Опубликована) [дата публикации]
T -> AU : записать(публикация версии)
T --> UI : новые заявки оцениваются этой версией
opt качество новой версии хуже ожидаемого
  RA -> UI : откатиться на архивную версию
  UI -> T : откатить(архивная)
  T -> M : setСтатус(архивная — Опубликована, текущая — В архиве)
end
@enduml
