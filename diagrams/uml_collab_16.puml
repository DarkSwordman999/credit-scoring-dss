@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Администратор" as AD
rectangle ":ЭкранАдминистрирования\n«boundary»" as UI
rectangle ":СервисАдминистрирования\n«control»" as S
rectangle ":Сотрудник\n«entity»" as E
rectangle ":Параметр\n«entity»" as PS
rectangle ":ЖурналАудита\n«entity»" as AU
rectangle ":ЖурналОбмена\n«entity»" as IL
AD -- UI : "1: добавить пользователя (логин,\nФИО, роль, лимит, пароль) ↓\n8: изменить роль, лимит или\nзаблокировать ↓\n13: изменить параметры системы ↓\n17: журнал аудита: период,\nлогин, действие ↓\n21: журнал обмена с БКИ, АБС,\nсервисом скоринга ↓"
UI -- S : "2: создатьПользователя(данные) ↓\n5: [логин занят или данные\nневерны] ошибка ↑\n9: изменитьПользователя(данные)\n↓\n14: сохранитьПараметры(значения)\n↓\n18: журналАудита(отбор) ↓\n20: записи «было → стало»\n(только чтение) ↑\n22: журналОбмена(отбор) ↓"
S -- S : "3: проверить() [роль известна,\nпароль ≥ 6 символов]\n10: запретитьБлокировкуСебя()"
S -- E : "4: найти(логин) ↓\n6: [корректно] создать(хэш\nпароля, роль, лимит) ↓\n11: обновить() ↓"
S -- AU : "7: [корректно] записать(создан\nпользователь) ↓\n12: записать(изменения было →\nстало) ↓\n16: записать(изменены параметры)\n↓\n19: выбрать(отбор) ↓"
S -- PS : "15: setЗначение() [проверка\nдиапазонов] ↓"
S -- IL : "23: выбрать(отбор) ↓"
@enduml
