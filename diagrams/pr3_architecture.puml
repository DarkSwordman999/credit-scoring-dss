@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
skinparam componentStyle rectangle
actor "Кредитный\nспециалист" as KS
actor "Андеррайтер" as UW
actor "Риск-аналитик" as RA
rectangle "Клиентская часть\n(веб-интерфейс АРМ)" as UI
rectangle "Серверная часть СППР" as SRV {
  rectangle "Подсистема приёма\nи учёта заявок" as A
  rectangle "Подсистема сбора\nи верификации данных" as B
  rectangle "Подсистема скоринга\n(ML-модуль)" as C
  rectangle "Подсистема поддержки\nпринятия решений" as D
  rectangle "Подсистема мониторинга\nи обучения моделей" as E
  rectangle "Подсистема отчётности" as F
  rectangle "Подсистема\nадминистрирования" as G
}
database "БД заявок\nи клиентов" as DB
database "Реестр\nмоделей" as MR
rectangle "Бюро кредитных\nисторий (БКИ)" as BKI
rectangle "Автоматизированная\nбанковская система" as ABS
KS --> UI
UW --> UI
RA --> UI
UI --> A
UI --> D
UI --> F
A --> B
B --> C
C --> D
E --> C
B --> BKI
B --> ABS
D --> ABS
A --> DB
C --> MR
E --> MR
@enduml
