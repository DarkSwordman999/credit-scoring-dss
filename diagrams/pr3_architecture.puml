@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
skinparam componentStyle rectangle
actor "Специалист\nпо займам" as KS
rectangle "Персональный компьютер организации (Windows)" as PC {
  rectangle "Веб-браузер" as UI
  rectangle "Программа «Кредитный скоринг Базовая»\n(Python, Flask)" as SRV {
    rectangle "Учёт заявок\nи клиентов" as A
    rectangle "Оценка заявки\n(стоп-факторы, ПДН,\nскоринговая карта)" as C
    rectangle "Решение\nпо заявке" as D
    rectangle "Отчёт и справочник\nпродуктов" as F
  }
  database "Файл базы данных\nSQLite (creditdss.db)" as DB
}
rectangle "Портал бюро\nкредитных историй" as BKI
KS --> UI
UI --> A
UI --> D
UI --> F
A --> C
C --> D
A --> DB
C --> DB
D --> DB
F --> DB
KS ..> BKI : кредитный отчёт\n(вручную)
@enduml
