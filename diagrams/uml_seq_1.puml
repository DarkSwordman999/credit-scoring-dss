@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Кредитный специалист" as KS
boundary "ФормаЗаявки" as UI
control "КонтроллерЗаявок" as C
entity "Клиент" as CL
entity "Занятость" as EM
entity "Заявка" as AP
entity "Согласие" as CS
entity "ЖурналАудита" as AU
KS -> UI : ввести серию и номер паспорта
UI -> C : найтиКлиента(паспорт)
C -> CL : найти(серия, номер)
CL --> C : клиент и прежние заявки
C --> UI : анкета заполнена данными клиента
KS -> UI : заполнить анкету, доход, продукт, сумму, срок, согласия
UI -> C : создатьЧерновик(анкета)
C -> C : проверитьЧисловыеПоля()
C -> CL : найтиИлиСоздать(паспорт)
C -> EM : создать(тип занятости, доход, стаж)
C -> AP : создать(номер КЗ-ГГГГ-NNNNNN, статус = Черновик)
C -> CS : сохранить(согласия pd, bki)
KS -> UI : зарегистрировать
UI -> C : зарегистрировать(заявка)
C -> C : проверитьДляРегистрации() (С-1, С-2)
alt есть ошибки
  C --> UI : список ошибок
  UI --> KS : показать ошибки, заявка остаётся черновиком
else ошибок нет
  C -> AP : setСтатус(Зарегистрирована)
  C -> AU : записать(регистрация заявки)
  C -> C : собратьДосье(заявка) <<include>>
  C --> UI : карточка заявки с оценкой
  UI --> KS : заявка зарегистрирована
end
@enduml
