@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
control "new_application()" as C
control "ОценкаЗаявки" as L
control "СкоринговаяКарта" as S
L <- C : evaluate(анкета, продукт)
L -> L : ПДН = (платежи + аннуитет) / доход
L -> L : stop_factor(анкета)
alt стоп-фактор сработал
  L --> C : рекомендация «Отказать», стоп-фактор
else стоп-факторов нет
  L -> S : score(анкета)
  S --> L : балл, баллы и вклад характеристик
  L -> L : PD = 1 / (1 + 50 · 2^((балл − 600) / 20))
  L -> L : класс риска по порогам PD
  L -> L : 3 фактора «против», 3 «за»
  L -> L : условия по классу риска и ПДН
  L --> C : балл, PD, класс, факторы,\nрекомендация, сумма, ставка
end
@enduml
