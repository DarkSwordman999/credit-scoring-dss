@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
|Риск-аналитик|
start
:Создать кандидата на основе версии;
repeat
  :Изменить баллы и границы интервалов;
  :Проверить на созревших кредитах;
  |Система|
  :ROC AUC, Gini, KS кандидата
  и действующей версии;
  |Риск-аналитик|
repeat while (Gini кандидата ниже?) is (да)
-> нет;
:Отправить на утверждение;
|Руководитель отдела|
if (Утвердить?) then (да)
  |Риск-аналитик|
  :Опубликовать;
  |Система|
  :Предыдущая версия — в архив;
  :Новые заявки оцениваются
  опубликованной версией;
else (нет)
  :Отклонить с причиной;
endif
stop
@enduml
