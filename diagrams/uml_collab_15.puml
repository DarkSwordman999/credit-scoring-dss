@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Риск-аналитик" as RA
rectangle ":ЭкранСправочников\n«boundary»" as UI
rectangle ":СервисСправочников\n«control»" as S
rectangle ":СтопФактор\n«entity»" as SF
rectangle ":Параметр\n«entity»" as PS
rectangle ":ПравилоУсловий\n«entity»" as PR
actor "Администратор" as AD
rectangle ":КредитныйПродукт\n«entity»" as PD
rectangle ":ЗаписьСтопЛиста\n«entity»" as SL
rectangle ":ЖурналАудита\n«entity»" as AU
RA -- UI : "1: изменить стоп-фактор (порог,\nактивность) ↓\n5: изменить пороги классов риска\nи матрицу условий ↓"
UI -- S : "2: сохранитьСтопФактор(данные) ↓\n6: сохранитьУсловия(классы,\nматрица) ↓\n8: [матрица неверна] ошибка ↑\n12: сохранитьПродукт(название,\nсуммы, сроки, ставка) ↓\n16: добавитьВСтопЛист(паспорт,\nФИО, основание) ↓"
S -- S : "3: проверитьПравило() [тип\nусловия, порог]\n7: проверитьМатрицу() [пороги\nвозрастают, интервалы ПДН без\nразрывов]\n13: проверитьГраницы() [мин ≤\nмакс, название уникально]"
S -- SF : "4: обновить() ↓"
S -- PS : "9: [верна] setКлассыРиска() ↓"
S -- PR : "10: [верна] заменить(матрица) ↓"
UI -- AD : "11: добавить кредитный продукт ↑\n15: добавить запись во\nвнутренний стоп-лист ↑"
S -- PD : "14: создать() ↓"
S -- SL : "17: создать() ↓"
S -- AU : "18: записать(изменение\nсправочника) ↓"
@enduml
