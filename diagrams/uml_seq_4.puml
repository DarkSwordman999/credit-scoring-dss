@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Руководитель" as HD
boundary "products.html\n(Справочник)" as UI
control "products()" as C
entity "Продукт" as PR
HD -> UI : открыть справочник
UI -> C : GET /products
C -> PR : все продукты
C --> UI : таблица продуктов
HD -> UI : наименование, диапазоны, ставка
UI -> C : POST /products
C -> PR : добавить(продукт)
C --> UI : «Продукт добавлен»
@enduml
