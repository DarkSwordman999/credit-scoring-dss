@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
control "СервисДосье" as DS
control "КлиентСкоринга" as SC
control "СервисСкоринга" as S
control "ПостроительДосье" as B
control "ПроверкаСтопФакторов" as SF
control "СкоринговаяКарта" as M
entity "ВерсияМетодики" as V
entity "ПравилоУсловий" as PR
entity "РезультатСкоринга" as R
entity "Заявка" as AP
DS -> SC : оценить(заявка)
SC -> S : оценить(заявка) [POST /score]
S -> B : построить(заявка): анкета, БКИ, АБС, проверки
S -> V : опубликованная()
S -> SF : проверить(досье, стоп-факторы)
alt сработал стоп-фактор
  S -> S : отказатьПоСтопФактору()
else стоп-факторов нет
  S -> M : баллы(признаки, параметры версии)
  M --> S : балл, вклад характеристик
  S -> S : рассчитатьPD(балл) [логистическая функция]
  S -> S : рассчитатьПДН() [(платежи + новый платёж) / доход]
  S -> S : определитьКлассРиска(PD) [пороги A–E]
  S -> PR : условия(класс, ПДН)
  S -> S : сформироватьРекомендацию() [сумма, срок, ставка]
end
S --> SC : результат оценки
alt сервис скоринга недоступен
  SC -> SC : оценитьРезервнойМетодикой() [пометка fallback]
end
SC --> DS : PD, балл, класс, ПДН, факторы
DS -> R : создать(результат, версия методики)
DS -> AP : setСтатус(На рассмотрении)
@enduml
