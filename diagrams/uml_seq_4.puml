@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Руководитель отдела" as HD
boundary "ЭкранОтчётов" as UI
control "СервисОтчётов" as S
entity "Заявка" as AP
entity "Решение" as D
entity "РезультатСкоринга" as R
HD -> UI : выбрать вид отчёта и период
UI -> S : сформировать(вид, период)
S -> AP : выбрать(период)
S -> D : выбрать(период)
S -> R : выбрать(период)
S -> S : агрегировать показатели (число заявок, уровень одобрения, распределение по классам риска)
S --> UI : данные отчёта
UI --> HD : таблицы и графики
HD -> UI : выгрузить в XLSX
UI --> HD : файл отчёта
@enduml
