@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Риск-аналитик" as RA
boundary "ЭкранСправочников" as UI
control "СервисСправочников" as S
entity "СтопФактор" as SF
entity "Параметр" as PS
entity "ПравилоУсловий" as PR
actor "Администратор" as AD
entity "КредитныйПродукт" as PD
entity "ЗаписьСтопЛиста" as SL
entity "ЖурналАудита" as AU
RA -> UI : изменить стоп-фактор (порог, активность)
UI -> S : сохранитьСтопФактор(данные)
S -> S : проверитьПравило() [тип условия, порог]
S -> SF : обновить()
RA -> UI : изменить пороги классов риска и матрицу условий
UI -> S : сохранитьУсловия(классы, матрица)
S -> S : проверитьМатрицу() [пороги возрастают, интервалы ПДН без разрывов]
alt матрица неверна
  S --> UI : ошибка
else верна
  S -> PS : setКлассыРиска()
  S -> PR : заменить(матрица)
end
AD -> UI : добавить кредитный продукт
UI -> S : сохранитьПродукт(название, суммы, сроки, ставка)
S -> S : проверитьГраницы() [мин ≤ макс, название уникально]
S -> PD : создать()
AD -> UI : добавить запись во внутренний стоп-лист
UI -> S : добавитьВСтопЛист(паспорт, ФИО, основание)
S -> SL : создать()
S -> AU : записать(изменение справочника)
@enduml
