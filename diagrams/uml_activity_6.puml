@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
|Андеррайтер|
start
:Открыть заявку «На рассмотрении»;
:Изучить досье, оценку и факторы;
if (Нужны документы?) then (да)
  :Запросить документы с комментарием;
  |Система|
  :Статус «Требуются документы»;
  stop
else (нет)
endif
|Андеррайтер|
:Выбрать решение и условия;
|Система|
if (Условия в диапазонах продукта?) then (нет)
  :Ошибка;
  stop
else (да)
endif
if (Решение отличается от рекомендации\nи комментарий короче 20 символов?) then (да)
  :Ошибка С-11;
  stop
else (нет)
endif
if (Сумма больше лимита полномочий?) then (да)
  :Статус «На кредитном комитете»;
else (нет)
  :Статус «Одобрена» или «Отклонена»;
  :Уведомить клиента: условия
  или причины отказа;
endif
:Записать в журнал аудита;
stop
@enduml
