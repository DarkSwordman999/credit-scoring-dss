@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
|Кредитный специалист|
start
:Ввести паспорт клиента;
|Система|
if (Клиент обращался ранее?) then (да)
  :Заполнить анкету прежними данными;
else (нет)
endif
|Кредитный специалист|
:Заполнить анкету, доход, продукт,
сумму, срок, отметить согласия;
:Сохранить черновик;
|Система|
:Проверить числовые поля;
|Кредитный специалист|
:Зарегистрировать заявку;
|Система|
:Проверить обязательные поля, возраст 18+,
паспорт, диапазоны продукта, доход,
контакт для уведомления, согласия (С-1, С-2);
if (Есть ошибки?) then (да)
  :Показать список ошибок;
  |Кредитный специалист|
  :Исправить анкету;
  stop
else (нет)
  |Система|
  :Статус «Зарегистрирована»;
  :Собрать кредитное досье;
  :Показать карточку с оценкой;
  stop
endif
@enduml
