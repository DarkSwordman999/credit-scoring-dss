@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Кредитный специалист" as KS
rectangle ":ФормаЗаявки\n«boundary»" as UI
rectangle ":КонтроллерЗаявок\n«control»" as C
rectangle ":Клиент\n«entity»" as CL
rectangle ":Занятость\n«entity»" as EM
rectangle ":Заявка\n«entity»" as AP
rectangle ":Согласие\n«entity»" as CS
rectangle ":ЖурналАудита\n«entity»" as AU
KS -- UI : "1: ввести серию и номер паспорта\n↓\n6: заполнить анкету, доход,\nпродукт, сумму, срок, согласия ↓\n13: зарегистрировать ↓\n17: [есть ошибки] показать\nошибки, заявка остаётся\nчерновиком ↑\n22: [ошибок нет] заявка\nзарегистрирована ↑"
UI -- C : "2: найтиКлиента(паспорт) ↓\n5: анкета заполнена данными\nклиента ↑\n7: создатьЧерновик(анкета) ↓\n14: зарегистрировать(заявка) ↓\n16: [есть ошибки] список ошибок\n↑\n21: [ошибок нет] карточка заявки\nс оценкой ↑"
C -- CL : "3: найти(серия, номер) ↓\n4: клиент и прежние заявки ↑\n9: найтиИлиСоздать(паспорт) ↓"
C -- C : "8: проверитьЧисловыеПоля()\n15: проверитьДляРегистрации()\n(С-1, С-2)\n20: [ошибок нет]\nсобратьДосье(заявка) <<include>>"
C -- EM : "10: создать(тип занятости,\nдоход, стаж) ↓"
C -- AP : "11: создать(номер КЗ-ГГГГ-\nNNNNNN, статус = Черновик) ↓\n18: [ошибок нет]\nsetСтатус(Зарегистрирована) ↓"
C -- CS : "12: сохранить(согласия pd, bki)\n↓"
C -- AU : "19: [ошибок нет]\nзаписать(регистрация заявки) ↓"
@enduml
