@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Администратор" as AD
boundary "ЭкранАдминистрирования" as UI
control "СервисАдминистрирования" as S
entity "Сотрудник" as E
entity "Параметр" as PS
entity "ЖурналАудита" as AU
entity "ЖурналОбмена" as IL
AD -> UI : добавить пользователя (логин, ФИО, роль, лимит, пароль)
UI -> S : создатьПользователя(данные)
S -> S : проверить() [роль известна, пароль ≥ 6 символов]
S -> E : найти(логин)
alt логин занят или данные неверны
  S --> UI : ошибка
else корректно
  S -> E : создать(хэш пароля, роль, лимит)
  S -> AU : записать(создан пользователь)
end
AD -> UI : изменить роль, лимит или заблокировать
UI -> S : изменитьПользователя(данные)
S -> S : запретитьБлокировкуСебя()
S -> E : обновить()
S -> AU : записать(изменения было → стало)
AD -> UI : изменить параметры системы
UI -> S : сохранитьПараметры(значения)
S -> PS : setЗначение() [проверка диапазонов]
S -> AU : записать(изменены параметры)
AD -> UI : журнал аудита: период, логин, действие
UI -> S : журналАудита(отбор)
S -> AU : выбрать(отбор)
S --> UI : записи «было → стало» (только чтение)
AD -> UI : журнал обмена с БКИ, АБС, сервисом скоринга
UI -> S : журналОбмена(отбор)
S -> IL : выбрать(отбор)
@enduml
