@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
node "Персональный компьютер Организации\n<<Windows 10/11>>" as pc {
  artifact "Веб-браузер" as br
  component "Python 3.11+\nFlask (app.py)\n127.0.0.1:5000" as be
  database "creditdss.db\n(SQLite)" as db
  artifact "run.bat, run.py\nwheels (пакеты)" as run
  artifact "secret.key" as key
}
node "Портал бюро\nкредитных историй" as bki
run --> be : запуск
br --> be : HTTP (только localhost)
be --> db : SQL
be --> key : ключ сессии
br ..> bki : HTTPS (специалист вручную)
@enduml
