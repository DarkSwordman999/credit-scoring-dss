@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
node "АРМ сотрудника\n<<device>>" as pc {
  artifact "Веб-браузер" as br
}
node "Сервер приложений\n<<Linux, Docker>>" as app {
  component "proxy\n(Caddy, HTTPS)" as fe
  component "api\n(FastAPI + интерфейс React)" as be
  component "scoring\n(сервис скоринга)" as sc
  component "scheduler\n(планировщик)" as gw
}
node "Сервер БД\n<<Linux>>" as dbs {
  database "PostgreSQL\n(credit_db)" as db
}
node "Бюро кредитных историй" as bki
node "АБС Банка" as abs
node "Контроллер домена\n(LDAP)" as ldap
br --> fe : HTTPS
fe --> be : REST
be --> sc : REST (POST /score)
be --> bki : HTTPS (TLS)
be --> abs : API
be --> db : SQL
sc --> db : версия методики
gw --> db : повтор запросов БКИ,\nмониторинг, резервные копии
be --> ldap : LDAP
@enduml
