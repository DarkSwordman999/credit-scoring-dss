@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Пользователь" as U
boundary "ФормаВхода" as UI
control "КонтроллерВхода" as C
entity "Сотрудник" as E
participant "Контроллер домена" as LD
entity "ЖурналАудита" as AU
U -> UI : ввести логин и пароль
UI -> C : получитьТокен(логин, пароль)
C -> E : найти(логин)
alt учётная запись не найдена или заблокирована
  C --> UI : 401 «Неверный логин или пароль»
  UI --> U : показать ошибку
else учётная запись действует
  opt задан адрес службы каталогов
    C -> LD : проверить пароль (LDAP bind)
    LD --> C : результат
  end
  C -> C : проверитьХэшПароля() [если LDAP не подтвердил]
  C -> C : выпуститьТокен(сотрудник, роль, срок)
  C -> AU : записать(вход в систему)
  C --> UI : токен и сведения о пользователе
  UI --> U : главная страница для роли
end
@enduml
