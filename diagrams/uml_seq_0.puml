@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Специалист" as KS
boundary "new.html\n(ФормаЗаявки)" as UI
control "new_application()" as C
entity "Продукт" as PR
entity "Клиент" as CL
control "ОценкаЗаявки\n(logic.evaluate)" as L
entity "Заявка" as AP
KS -> UI : анкета, продукт, сумма, срок,\nсведения БКИ, согласие
UI -> C : POST /new
C -> PR : получить(product_id)
C -> C : проверить поля, диапазоны, согласие
alt есть ошибки
  C --> UI : сообщения об ошибках
  UI --> KS : форма с введёнными данными
else ошибок нет
  C -> CL : найти(паспорт)
  opt клиент не найден
    C -> CL : создать(анкета)
  end
  C -> L : evaluate(анкета, продукт)
  L --> C : оценка и рекомендация
  C -> AP : создать(анкета, сведения БКИ, оценка)
  C --> UI : перейти к карточке заявки
  UI --> KS : «Заявка оценена»
end
@enduml
