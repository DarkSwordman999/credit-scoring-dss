@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Кредитный специалист" as KS
rectangle ":КарточкаЗаявки\n«boundary»" as UI
rectangle ":КонтроллерЗаявок\n«control»" as C
rectangle ":Решение\n«entity»" as D
rectangle ":АдаптерАБС\n«control»" as AA
rectangle ":АБС" as ABS
rectangle ":Кредит\n«entity»" as LN
rectangle ":Заявка\n«entity»" as AP
rectangle ":ЖурналОбмена\n«entity»" as IL
rectangle ":ЖурналАудита\n«entity»" as AU
KS -- UI : "1: [клиент подписал договор]\nкредит выдан ↓\n14: [клиент отказался] отказ\nклиента, комментарий ↓"
UI -- C : "2: [клиент подписал договор]\nвыдать(заявка) ↓\n8: [АБС недоступна] 503 «Не\nудалось передать заявку в АБС» ↑\n13: [договор оформлен] кредит\nвыдан ↑\n15: [клиент отказался]\nотказКлиента(заявка,\nкомментарий) ↓"
C -- D : "3: [клиент подписал договор]\nпоследнееОдобрение(заявка) ↓"
C -- AA : "4: [клиент подписал договор]\nпередатьОдобренную(номер, сумма,\nсрок, ставка) ↓\n6: [АБС недоступна] ошибка ↑"
AA -- ABS : "5: [клиент подписал договор]\nзаявка на оформление договора ↓\n9: [договор оформлен] номер\nдоговора ↑"
C -- IL : "7: [АБС недоступна]\nзаписать(ошибка АБС) ↓"
C -- LN : "10: [договор оформлен]\nсоздать(договор, дата выдачи,\nсумма, срок, ставка) ↓"
C -- AP : "11: [договор оформлен]\nsetСтатус(Выдана) ↓\n16: [клиент отказался]\nsetСтатус(Отказ клиента) ↓"
C -- AU : "12: [договор оформлен]\nзаписать(кредит выдан) ↓\n17: [клиент отказался]\nзаписать(отказ клиента) ↓"
@enduml
