@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Руководитель" as HD
boundary "report.html\n(Отчёт)" as UI
control "report()" as C
entity "Заявка" as AP
HD -> UI : выбрать период (30–365 дней)
UI -> C : GET /report?days=N
C -> AP : сгруппировать по классу риска:\nзаявки, одобрено, отклонено, сумма
AP --> C : строки отчёта
C -> C : итоги, уровень одобрения
C --> UI : таблица по классам риска
UI --> HD : отчёт
@enduml
