@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Риск-аналитик" as RA
boundary "ЭкранМетодики" as UI
control "СервисМетодики" as T
entity "Кредит" as LN
entity "ВерсияМетодики" as M
actor "Руководитель отдела" as HD
RA -> UI : создать версию на основе действующей
UI -> T : создатьКандидата(действующая)
T -> M : создать(баллы, статус = "Кандидат")
RA -> UI : изменить баллы характеристик
RA -> UI : проверить на истории (период выдачи)
UI -> T : проверить(версия, период)
T -> LN : выбрать кредиты старше 12 мес.
LN --> T : заявки и факт дефолта
T -> T : ROC AUC, Gini, KS кандидата и действующей
T -> M : сохранитьМетрики()
T --> UI : результаты проверки
RA -> UI : отправить на утверждение [Gini не ниже]
UI -> HD : запрос на утверждение
HD --> UI : утверждено
RA -> UI : опубликовать
UI -> M : опубликовать(версия)
M -> M : статус = "Опубликована", предыдущая = "Архив"
UI --> RA : версия опубликована
@enduml
