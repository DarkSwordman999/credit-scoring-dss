@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
control "КонтроллерЗаявок" as C
control "СервисДосье" as DS
control "АдаптерБКИ" as BA
participant "БКИ" as BKI
control "АдаптерАБС" as AA
participant "АБС" as ABS
control "СервисПроверок" as V
entity "ЗаписьСтопЛиста" as SL
entity "Проверка" as VR
entity "КредитныйОтчёт" as CR
entity "ДанныеАБС" as AD
entity "ЗапросБКИ" as RQ
entity "Заявка" as AP
C -> DS : собрать(заявка)
DS -> AP : setСтатус(Сбор данных)
par параллельно
  DS -> BA : запроситьОтчёт(субъект, согласие)
  BA -> BKI : запрос кредитного отчёта
  BKI --> BA : кредитный отчёт или «не найден»
  DS -> AA : запроситьДанные(субъект)
  AA -> ABS : запрос сведений о клиенте
  ABS --> AA : счета, зарплата, кредиты Банка
  DS -> V : проверить(субъект, стоп-лист)
  V -> SL : выбратьВсе()
end
DS -> VR : сохранить(паспорт, стоп-лист, Росфинмониторинг)
alt БКИ или АБС недоступны
  DS -> RQ : увеличитьПопытки() [следующая через 5 мин]
  DS --> C : заявка ждёт данных («Сбор данных»)
else данные получены
  DS -> CR : сохранить(отчёт)
  DS -> AD : сохранить(данные АБС)
  DS -> RQ : setСтатус(ok)
  DS -> AP : setСтатус(Скоринг)
  DS -> DS : выполнитьСкоринг(заявка) <<include>>
  DS --> C : досье сформировано
end
@enduml
