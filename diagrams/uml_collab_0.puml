@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Пользователь" as U
rectangle ":ФормаВхода\n«boundary»" as UI
rectangle ":КонтроллерВхода\n«control»" as C
rectangle ":Сотрудник\n«entity»" as E
rectangle ":Контроллер домена" as LD
rectangle ":ЖурналАудита\n«entity»" as AU
U -- UI : "1: ввести логин и пароль ↓\n5: [учётная запись не найдена\nили заблокирована] показать\nошибку ↑\n12: [учётная запись действует]\nглавная страница для роли ↑"
UI -- C : "2: получитьТокен(логин, пароль)\n↓\n4: [учётная запись не найдена\nили заблокирована] 401 «Неверный\nлогин или пароль» ↑\n11: [учётная запись действует]\nтокен и сведения о пользователе\n↑"
C -- E : "3: найти(логин) ↓"
C -- LD : "6: [задан адрес службы\nкаталогов] проверить пароль\n(LDAP bind) ↓\n7: [задан адрес службы\nкаталогов] результат ↑"
C -- C : "8: [учётная запись действует]\nпроверитьХэшПароля() [если LDAP\nне подтвердил]\n9: [учётная запись действует]\nвыпуститьТокен(сотрудник, роль,\nсрок)"
C -- AU : "10: [учётная запись действует]\nзаписать(вход в систему) ↓"
@enduml
