@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Кредитный специалист" as KS
rectangle ":КарточкаЗаявки\n«boundary»" as UI
rectangle ":КонтроллерЗаявок\n«control»" as C
rectangle ":Заявка\n«entity»" as AP
rectangle ":Документ\n«entity»" as D
rectangle ":Хранилище файлов" as FS
rectangle ":ЖурналАудита\n«entity»" as AU
KS -- UI : "1: выбрать вид документа и файл\n↓\n11: удалить ошибочный документ ↓"
UI -- C : "2: прикрепить(заявка, вид, файл)\n↓\n4: [прикрепление недоступно в\nэтом состоянии] 409 «В этом\nсостоянии документы не\nприкрепляются» ↑\n6: [файл не прошёл проверку]\nошибка формата или размера ↑\n10: [файл корректен] обновлённый\nсписок документов ↑\n12: удалитьДокумент(заявка,\nдокумент) ↓"
C -- AP : "3: доступныеДействия(роль,\nстатус) ↓"
C -- C : "5: [доступно] проверитьФайл()\n[PDF, JPG, PNG, не более 20 МБ,\nне пустой]\n13: проверитьСтатус() [Черновик\nили Требуются документы]"
C -- FS : "7: [файл корректен] сохранить\nпод случайным именем ↓\n14: удалить файл ↓"
C -- D : "8: [файл корректен] создать(вид,\nимя, тип, размер, кто прикрепил)\n↓\n15: удалить() ↓"
C -- AU : "9: [файл корректен]\nзаписать(прикреплён документ) ↓\n16: записать(удалён документ) ↓"
@enduml
