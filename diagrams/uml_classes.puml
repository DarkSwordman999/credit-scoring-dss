@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
package "Шаблоны страниц (templates)" {
 class ФормаВхода <<boundary>>
 class СписокЗаявок <<boundary>>
 class ФормаЗаявки <<boundary>>
 class КарточкаЗаявки <<boundary>>
 class Отчёт <<boundary>>
 class СправочникПродуктов <<boundary>>
}
package "Обработчики страниц (app.py)" {
 class Вход <<control>>
 class ОбработчикСписка <<control>>
 class ОбработчикНовойЗаявки <<control>>
 class ОбработчикКарточки <<control>>
 class ОбработчикОтчёта <<control>>
 class ОбработчикПродуктов <<control>>
}
package "Правила оценки (logic.py)" {
 class ОценкаЗаявки <<control>>
 class СкоринговаяКарта <<control>>
}
package "Данные (db.py, schema.sql)" {
 class Пользователь <<entity>> {
  логин
  хэшПароля
 }
 class Продукт <<entity>> {
  диапазоны
  ставка
 }
 class Клиент <<entity>> {
  ФИО
  паспорт
 }
 class Заявка <<entity>> {
  анкета
  сведенияБКИ
  оценка
  решение
 }
}
ФормаВхода --> Вход
СписокЗаявок --> ОбработчикСписка
ФормаЗаявки --> ОбработчикНовойЗаявки
КарточкаЗаявки --> ОбработчикКарточки
Отчёт --> ОбработчикОтчёта
СправочникПродуктов --> ОбработчикПродуктов
Вход --> Пользователь
ОбработчикНовойЗаявки --> ОценкаЗаявки
ОценкаЗаявки --> СкоринговаяКарта
ОбработчикНовойЗаявки --> Клиент
ОбработчикНовойЗаявки --> Заявка
ОбработчикКарточки --> Заявка
ОбработчикСписка --> Заявка
ОбработчикОтчёта --> Заявка
ОбработчикПродуктов --> Продукт
Клиент "1" -- "0..*" Заявка
Продукт "1" -- "0..*" Заявка
@enduml
