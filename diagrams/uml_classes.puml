@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
hide members
left to right direction
skinparam linetype ortho
package "Граничные классы" {
 class ФормаВхода <<boundary>>
 class ФормаЗаявки <<boundary>>
 class КарточкаЗаявки <<boundary>>
 class ЭкранМетодики <<boundary>>
 class ЭкранОтчётов <<boundary>>
 class РеестрЗаёмщиков <<boundary>>
 class ЭкранПортфеля <<boundary>>
 class ЭкранСправочников <<boundary>>
 class ЭкранАдминистрирования <<boundary>>
 class ЭкранТаблицБД <<boundary>>
 class ШлюзАБС <<boundary>>
}
package "Управляющие классы" {
 class КонтроллерВхода <<control>>
 class КонтроллерЗаявок <<control>>
 class КонтроллерРешений <<control>>
 class СервисДосье <<control>>
 class СервисПроверок <<control>>
 class АдаптерБКИ <<control>>
 class АдаптерАБС <<control>>
 class КлиентСкоринга <<control>>
 class СервисСкоринга <<control>>
 class Уведомитель <<control>>
 class СервисМетодики <<control>>
 class ПланировщикЗадач <<control>>
 class СервисОтчётов <<control>>
 class СервисПортфеля <<control>>
 class СервисСправочников <<control>>
 class СервисАдминистрирования <<control>>
 class СервисРезервногоКопирования <<control>>
}
package "Классы-сущности" {
 class Клиент <<entity>>
 class Заявка <<entity>>
 class Согласие <<entity>>
 class Документ <<entity>>
 class КредитныйОтчёт <<entity>>
 class ДанныеАБС <<entity>>
 class Проверка <<entity>>
 class ЗапросБКИ <<entity>>
 class РезультатСкоринга <<entity>>
 class ВерсияМетодики <<entity>>
 class Решение <<entity>>
 class Кредит <<entity>>
 class Сотрудник <<entity>>
 class КредитныйПродукт <<entity>>
 class СтопФактор <<entity>>
 class ПравилоУсловий <<entity>>
 class ОтчётМониторинга <<entity>>
 class ЖурналАудита <<entity>>
}
ФормаВхода --> КонтроллерВхода
ФормаЗаявки --> КонтроллерЗаявок
КарточкаЗаявки --> КонтроллерЗаявок
КарточкаЗаявки --> КонтроллерРешений
ЭкранМетодики --> СервисМетодики
ЭкранОтчётов --> СервисОтчётов
РеестрЗаёмщиков --> СервисПортфеля
ЭкранПортфеля --> СервисПортфеля
ЭкранСправочников --> СервисСправочников
ЭкранАдминистрирования --> СервисАдминистрирования
ШлюзАБС --> Кредит
КонтроллерЗаявок --> СервисДосье
СервисДосье --> АдаптерБКИ
СервисДосье --> АдаптерАБС
СервисДосье --> СервисПроверок
СервисДосье --> КлиентСкоринга
КлиентСкоринга --> СервисСкоринга
КонтроллерРешений --> Уведомитель
ПланировщикЗадач --> СервисДосье
ПланировщикЗадач --> СервисМетодики
ПланировщикЗадач --> СервисРезервногоКопирования
СервисСкоринга --> ВерсияМетодики
СервисСкоринга --> СтопФактор
СервисСкоринга --> ПравилоУсловий
Клиент "1" -- "0..*" Заявка
Заявка "1" *-- "1..*" Согласие
Заявка "1" *-- "0..*" Документ
Заявка "1" -- "0..1" КредитныйОтчёт
Заявка "1" -- "0..1" ДанныеАБС
Заявка "1" -- "0..*" Проверка
Заявка "1" -- "0..1" ЗапросБКИ
Заявка "1" -- "0..*" РезультатСкоринга
Заявка "1" -- "0..*" Решение
Заявка "1" -- "0..1" Кредит
КредитныйПродукт "1" -- "0..*" Заявка
Сотрудник "1" -- "0..*" Решение
ВерсияМетодики "1" -- "0..*" РезультатСкоринга
ВерсияМетодики "1" -- "0..*" ОтчётМониторинга
КонтроллерЗаявок --> Заявка
КонтроллерРешений --> Решение
СервисМетодики --> ВерсияМетодики
СервисПортфеля --> Кредит
@enduml
