@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
package "Интерфейс" {
 class ФормаЗаявки <<boundary>>
 class КарточкаЗаявки <<boundary>>
 class ЭкранМетодики <<boundary>>
 class ЭкранОтчётов <<boundary>>
 class РеестрЗаёмщиков <<boundary>>
}
package "Управление" {
 class КонтроллерЗаявок <<control>>
 class КонтроллерРешений <<control>>
 class СервисСкоринга <<control>>
 class СервисМетодики <<control>>
 class СервисОтчётов <<control>>
 class АдаптерБКИ <<control>>
 class АдаптерАБС <<control>>
}
package "Сущности" {
 class Клиент <<entity>> {
  ФИО
  паспорт
  датаРождения
 }
 class Заявка <<entity>> {
  номер
  сумма
  срок
  статус
 }
 class КредитныйОтчёт <<entity>>
 class РезультатСкоринга <<entity>> {
  PD
  классРиска
  ПДН
 }
 class ВерсияМетодики <<entity>> {
  версия
  статус
 }
 class Кредит <<entity>> {
  договор
  состояние
 }
 class Решение <<entity>> {
  итог
  условия
 }
 class Сотрудник <<entity>> {
  роль
  лимит
 }
 class СтопФактор <<entity>>
}
ФормаЗаявки --> КонтроллерЗаявок
КарточкаЗаявки --> КонтроллерРешений
ЭкранМетодики --> СервисМетодики
ЭкранОтчётов --> СервисОтчётов
РеестрЗаёмщиков --> СервисОтчётов
КонтроллерЗаявок --> СервисСкоринга
КонтроллерЗаявок --> АдаптерБКИ
КонтроллерЗаявок --> АдаптерАБС
СервисСкоринга --> ВерсияМетодики
СервисСкоринга --> СтопФактор
СервисСкоринга --> РезультатСкоринга
СервисМетодики --> ВерсияМетодики
СервисМетодики --> Кредит
Клиент "1" -- "0..*" Заявка
Заявка "1" -- "0..1" КредитныйОтчёт
Заявка "1" -- "0..*" РезультатСкоринга
Заявка "1" -- "0..*" Решение
Сотрудник "1" -- "0..*" Решение
ВерсияМетодики "1" -- "0..*" РезультатСкоринга
Заявка "1" -- "0..1" Кредит
@enduml
