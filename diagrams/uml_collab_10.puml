@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Риск-аналитик" as RA
rectangle ":ЭкранМетодики\n«boundary»" as UI
rectangle ":СервисМетодики\n«control»" as T
rectangle ":ВерсияМетодики\n«entity»" as M
actor "Руководитель отдела" as HD
rectangle ":ЖурналАудита\n«entity»" as AU
RA -- UI : "1: отправить на утверждение ↓\n10: опубликовать ↓\n16: [качество новой версии хуже\nожидаемого] откатиться на\nархивную версию ↓"
UI -- T : "2: отправить(версия) ↓\n4: [метрик нет или Gini ниже]\nошибка ↑\n7: утвердить(версия, решение,\nкомментарий) ↓\n11: опубликовать(версия) ↓\n15: новые заявки оцениваются\nэтой версией ↑\n17: [качество новой версии хуже\nожидаемого] откатить(архивная) ↓"
T -- T : "3: проверитьМетрики() [есть\nпроверка, Gini не ниже\nдействующей]"
T -- M : "5: [можно отправить]\nsetСтатус(На утверждении) ↓\n8: [отклонено]\nsetСтатус(Отклонена) [с\nпричиной] ↓\n9: [утверждено]\nsetСтатус(Утверждена) [кто и\nкогда] ↓\n12: вАрхив(текущая\nопубликованная) ↓\n13: setСтатус(Опубликована)\n[дата публикации] ↓\n18: [качество новой версии хуже\nожидаемого] setСтатус(архивная —\nОпубликована, текущая — В\nархиве) ↓"
UI -- HD : "6: утвердить или отклонить с\nпричиной ↑"
T -- AU : "14: записать(публикация версии)\n↓"
@enduml
