@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ОценкаЗаявки <<control>> {
 +evaluate(анкета, продукт): Оценка
 -pdn(): float
 -annuity(): float
 -stop_factor(): строка
 -pd_from_score(балл): float
 -risk_class(PD): строка
}
class СкоринговаяКарта <<control>> {
 SCORECARD: 7 характеристик
 BASE_POINTS = 400
 +score(анкета): балл, факторы
}
class УсловияПоКлассам <<entity>> {
 CLASSES: пороги PD
 CONDITIONS: сумма, надбавка, предельный ПДН
}
class Оценка <<entity>> {
 ПДН
 балл
 PD
 классРиска
 стопФактор
 факторы
 рекомендация
 рекСумма, рекСтавка
}
ОценкаЗаявки --> СкоринговаяКарта
ОценкаЗаявки --> УсловияПоКлассам
ОценкаЗаявки --> Оценка
@enduml
