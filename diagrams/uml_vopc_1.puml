@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
class ФормаЗаявки <<boundary>> {
 +ввестиСериюНомер()
 +заполнитьАнкету()
 +зарегистрировать()
}
class КонтроллерЗаявок <<control>> {
 +найтиКлиента(паспорт)
 +создатьЧерновик(анкета)
 -проверитьЧисловыеПоля()
 +зарегистрировать(заявка)
 -проверитьДляРегистрации()
 -собратьДосье(заявка)
}
class Клиент <<entity>> {
 {field} last_name: строка(100)
 {field} first_name: строка(100)
 {field} middle_name: строка(100)
 {field} birth_date: дата
 {field} passport_series: строка(4)
 {field} passport_number: строка(6)
 --
 +найти(серия, номер)
 +найтиИлиСоздать(паспорт)
}
class Занятость <<entity>> {
 {field} employment_type: строка(30)
 {field} employer: строка(200)
 {field} position: строка(200)
 {field} experience_months: целое
 {field} income_confirmed: деньги
 --
 +создать(тип занятости, доход, стаж)
}
class Заявка <<entity>> {
 {field} number: строка(30)
 {field} amount: деньги
 {field} term_months: целое
 {field} purpose: строка(200)
 {field} channel: строка(20)
 {field} marital_status: строка(20)
 --
 +создать(...)
 +setСтатус(Зарегистрирована)
}
class Согласие <<entity>> {
 {field} kind: строка(10)
 {field} signed_at: дата
 {field} valid_until: дата
 --
 +сохранить(согласия pd, bki)
}
class ЖурналАудита <<entity>> {
 {field} user_login: строка(64)
 {field} action: строка(200)
 {field} entity: строка(50)
 {field} changes: JSON
 --
 +записать(регистрация заявки)
}
ФормаЗаявки --> КонтроллерЗаявок
КонтроллерЗаявок --> Клиент
КонтроллерЗаявок --> Занятость
КонтроллерЗаявок --> Заявка
КонтроллерЗаявок --> Согласие
КонтроллерЗаявок --> ЖурналАудита
Клиент "1" -- "0..*" Занятость
Клиент "1" -- "0..*" Заявка
Занятость "1" -- "0..*" Заявка
Заявка "1" -- "0..*" Согласие
@enduml
