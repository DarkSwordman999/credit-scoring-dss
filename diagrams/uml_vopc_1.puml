@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class СервисСкоринга <<control>> {
 +оценить(заявка): РезультатСкоринга
 -определитьКлассРиска(PD)
 -сформироватьРекомендацию()
}
class ПостроительПризнаков <<control>> {
 +построить(досье): Вектор
}
class КалькуляторПДН <<control>> {
 +рассчитатьПДН(досье, сумма, срок): float
}
class ВерсияМетодики <<entity>> {
 версия
 баллыХарактеристик
 Gini
 статус
 +начислитьБаллы()
}
class СтопФактор <<entity>> {
 код
 условие
 активен
 +проверить()
}
class РезультатСкоринга <<entity>> {
 PD
 классРиска
 ПДН
 факторы
 рекомендация
}
class Заявка <<entity>>
СервисСкоринга --> ПостроительПризнаков
СервисСкоринга --> КалькуляторПДН
СервисСкоринга --> ВерсияМетодики
СервисСкоринга --> СтопФактор
СервисСкоринга --> РезультатСкоринга
Заявка "1" -- "0..*" РезультатСкоринга
ВерсияМетодики "1" -- "0..*" РезультатСкоринга
@enduml
