@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
rectangle ":СервисДосье\n«control»" as DS
rectangle ":КлиентСкоринга\n«control»" as SC
rectangle ":СервисСкоринга\n«control»" as S
rectangle ":ПостроительДосье\n«control»" as B
rectangle ":ПроверкаСтопФакторов\n«control»" as SF
rectangle ":СкоринговаяКарта\n«control»" as M
rectangle ":ВерсияМетодики\n«entity»" as V
rectangle ":ПравилоУсловий\n«entity»" as PR
rectangle ":РезультатСкоринга\n«entity»" as R
rectangle ":Заявка\n«entity»" as AP
DS -- SC : "1: оценить(заявка) ↓\n16: PD, балл, класс, ПДН,\nфакторы ↑"
SC -- S : "2: оценить(заявка) [POST /score]\n↓\n14: результат оценки ↑"
S -- B : "3: построить(заявка): анкета,\nБКИ, АБС, проверки ↓"
S -- V : "4: опубликованная() ↓"
S -- SF : "5: проверить(досье, стоп-\nфакторы) ↓"
S -- S : "6: [сработал стоп-фактор]\nотказатьПоСтопФактору()\n9: [стоп-факторов нет]\nрассчитатьPD(балл)\n[логистическая функция]\n10: [стоп-факторов нет]\nрассчитатьПДН() [(платежи +\nновый платёж) / доход]\n11: [стоп-факторов нет]\nопределитьКлассРиска(PD) [пороги\nA–E]\n13: [стоп-факторов нет]\nсформироватьРекомендацию()\n[сумма, срок, ставка]"
S -- M : "7: [стоп-факторов нет]\nбаллы(признаки, параметры\nверсии) ↓\n8: [стоп-факторов нет] балл,\nвклад характеристик ↑"
S -- PR : "12: [стоп-факторов нет]\nусловия(класс, ПДН) ↓"
SC -- SC : "15: [сервис скоринга недоступен]\nоценитьРезервнойМетодикой()\n[пометка fallback]"
DS -- R : "17: создать(результат, версия\nметодики) ↓"
DS -- AP : "18: setСтатус(На рассмотрении) ↓"
@enduml
