@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
skinparam wrapWidth 260
class АдаптерАБС <<control>> {
 +запроситьДанные(субъект)
 +передатьОдобренную(номер, сумма, срок, ставка)
}
class АдаптерБКИ <<control>> {
 +запроситьОтчёт(субъект, согласие)
}
class ВыгрузкаXLSX_PDF <<control>> {
 +построитьФайл(отчёт, формат)
}
class КлиентСкоринга <<control>> {
 +оценить(заявка)
 -оценитьРезервнойМетодикой()
}
class КонтроллерВхода <<control>> {
 +получитьТокен(логин, пароль)
 -проверитьХэшПароля()
 -выпуститьТокен(сотрудник, роль, срок)
}
class КонтроллерЗаявок <<control>> {
 +найтиКлиента(паспорт)
 +создатьЧерновик(анкета)
 -проверитьЧисловыеПоля()
 +зарегистрировать(заявка)
 -проверитьДляРегистрации()
 -собратьДосье(заявка)
 +прикрепить(...)
 -проверитьФайл()
 +удалитьДокумент(заявка, документ)
 -проверитьСтатус()
 +вернутьНаРассмотрение(заявка)
 +выдать(заявка)
 +отказКлиента(заявка, комментарий)
}
class КонтроллерРешений <<control>> {
 +карточка(заявка)
 +пересчитать(заявка)
 +решить(...)
 -проверитьУсловия()
 -отличаетсяОтРекомендации()
 +решениеКомитета(заявка, решение)
}
class ПланировщикЗадач <<control>> {
 +мониторингМетодики()
 +резервнаяКопия()
}
class ПостроительДосье <<control>> {
 +построить(заявка)
}
class ПроверкаСтопФакторов <<control>> {
 +проверить(досье, стоп-факторы)
}
class РасчётМетрик <<control>> {
 +метрики(кандидат, действующая)
 +PSI(оценки, эталон)
 +Gini(созревшие кредиты)
}
class СервисАдминистрирования <<control>> {
 +создатьПользователя(данные)
 -проверить()
 +изменитьПользователя(данные)
 -запретитьБлокировкуСебя()
 +сохранитьПараметры(значения)
 +журналАудита(отбор)
 +журналОбмена(отбор)
}
class СервисДосье <<control>> {
 +собрать(заявка)
 +выполнитьСкоринг(заявка)
}
class СервисМетодики <<control>> {
 +создатьКандидата(исходная)
 +изменитьКандидата(версия, параметры)
 -проверитьПараметры()
 +проверить(версия, период)
 +отправить(версия)
 -проверитьМетрики()
 +утвердить(версия, решение, комментарий)
 +опубликовать(версия)
 +откатить(архивная)
 +мониторинг(...)
 -сравнитьСПорогами()
 +историяМониторинга()
}
class СервисОтчётов <<control>> {
 +сформировать(...)
 -агрегировать()
}
class СервисПортфеля <<control>> {
 +реестр(отбор, страница)
 +карточка(клиент)
 +портфель(статус, период, отбор)
 -качествоПоКлассам()
}
class СервисПроверок <<control>> {
 +проверить(субъект, стоп-лист)
}
class СервисРезервногоКопирования <<control>> {
 +создатьКопию()
 +файлКопии(имя)
 +восстановить(файл)
 -страховочнаяКопия()
}
class СервисСкоринга <<control>> {
 +оценить(заявка)
 -отказатьПоСтопФактору()
 -рассчитатьPD(балл)
 -рассчитатьПДН()
 -определитьКлассРиска(PD)
 -сформироватьРекомендацию()
}
class СервисСправочников <<control>> {
 +сохранитьСтопФактор(данные)
 -проверитьПравило()
 +сохранитьУсловия(классы, матрица)
 -проверитьМатрицу()
 +сохранитьПродукт(...)
 -проверитьГраницы()
 +добавитьВСтопЛист(паспорт, ФИО, основание)
}
class СкоринговаяКарта <<control>> {
 +баллы(признаки, параметры версии)
}
class Уведомитель <<control>> {
 +уведомитьКлиента(заявка, решение)
}
АдаптерАБС -[hidden]down- КлиентСкоринга
АдаптерБКИ -[hidden]down- КонтроллерВхода
ВыгрузкаXLSX_PDF -[hidden]down- КонтроллерЗаявок
КлиентСкоринга -[hidden]down- КонтроллерРешений
КонтроллерВхода -[hidden]down- ПланировщикЗадач
КонтроллерЗаявок -[hidden]down- ПостроительДосье
КонтроллерРешений -[hidden]down- ПроверкаСтопФакторов
ПланировщикЗадач -[hidden]down- РасчётМетрик
ПостроительДосье -[hidden]down- СервисАдминистрирования
ПроверкаСтопФакторов -[hidden]down- СервисДосье
РасчётМетрик -[hidden]down- СервисМетодики
СервисАдминистрирования -[hidden]down- СервисОтчётов
СервисДосье -[hidden]down- СервисПортфеля
СервисМетодики -[hidden]down- СервисПроверок
СервисОтчётов -[hidden]down- СервисРезервногоКопирования
СервисПортфеля -[hidden]down- СервисСкоринга
СервисПроверок -[hidden]down- СервисСправочников
СервисРезервногоКопирования -[hidden]down- СкоринговаяКарта
СервисСкоринга -[hidden]down- Уведомитель
@enduml
