@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Андеррайтер" as UW
rectangle ":КарточкаЗаявки\n«boundary»" as UI
rectangle ":КонтроллерРешений\n«control»" as C
rectangle ":РезультатСкоринга\n«entity»" as R
rectangle ":Решение\n«entity»" as D
rectangle ":Сотрудник\n«entity»" as E
rectangle ":Заявка\n«entity»" as AP
rectangle ":Уведомитель\n«control»" as N
rectangle ":Уведомление\n«entity»" as NT
rectangle ":ЖурналАудита\n«entity»" as AU
UW -- UI : "1: открыть заявку из очереди «На\nрассмотрении» ↓\n5: [досье изменилось]\nпересчитать оценку ↓\n7: выбрать решение, сумму, срок,\nставку, комментарий ↓"
UI -- C : "2: карточка(заявка) ↓\n4: досье, PD, класс, ПДН,\nфакторы, рекомендация ↑\n6: [досье изменилось]\nпересчитать(заявка) ↓\n8: решить(заявка, решение) ↓\n11: [отличается, комментарий\nкороче 20 символов] ошибка С-11\n↑\n20: [проверки пройдены] решение\nсохранено ↑"
C -- R : "3: последний(заявка) ↓"
C -- C : "9: проверитьУсловия() [диапазоны\nпродукта]\n10: отличаетсяОтРекомендации()"
C -- E : "12: [проверки пройдены]\nлимитПолномочий() ↓"
C -- D : "13: [сумма больше лимита]\nсоздать(этап андеррайтер, итог =\nкомитет) ↓\n15: [в пределах лимита]\nсоздать(этап андеррайтер, итог,\nусловия) ↓"
C -- AP : "14: [сумма больше лимита]\nsetСтатус(На кредитном комитете)\n↓\n16: [в пределах лимита]\nsetСтатус(Одобрена / Отклонена)\n↓"
C -- N : "17: [в пределах лимита]\nуведомитьКлиента(заявка,\nрешение) ↓"
N -- NT : "18: [в пределах лимита]\nсоздать(SMS или e-mail, текст) ↓"
C -- AU : "19: [проверки пройдены]\nзаписать(решение, было → стало)\n↓"
@enduml
