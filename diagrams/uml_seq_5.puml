@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Андеррайтер" as UW
boundary "КарточкаЗаявки" as UI
control "КонтроллерРешений" as C
entity "РезультатСкоринга" as R
entity "Решение" as D
entity "Сотрудник" as E
entity "Заявка" as AP
control "Уведомитель" as N
entity "Уведомление" as NT
entity "ЖурналАудита" as AU
UW -> UI : открыть заявку из очереди «На рассмотрении»
UI -> C : карточка(заявка)
C -> R : последний(заявка)
C --> UI : досье, PD, класс, ПДН, факторы, рекомендация
opt досье изменилось
  UW -> UI : пересчитать оценку
  UI -> C : пересчитать(заявка)
end
UW -> UI : выбрать решение, сумму, срок, ставку, комментарий
UI -> C : решить(заявка, решение)
C -> C : проверитьУсловия() [диапазоны продукта]
C -> C : отличаетсяОтРекомендации()
alt отличается, комментарий короче 20 символов
  C --> UI : ошибка С-11
else проверки пройдены
  C -> E : лимитПолномочий()
  alt сумма больше лимита
    C -> D : создать(этап андеррайтер, итог = комитет)
    C -> AP : setСтатус(На кредитном комитете)
  else в пределах лимита
    C -> D : создать(этап андеррайтер, итог, условия)
    C -> AP : setСтатус(Одобрена / Отклонена)
    C -> N : уведомитьКлиента(заявка, решение)
    N -> NT : создать(SMS или e-mail, текст)
  end
  C -> AU : записать(решение, было → стало)
  C --> UI : решение сохранено
end
@enduml
