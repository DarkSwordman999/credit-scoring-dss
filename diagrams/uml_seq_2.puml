@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Специалист" as KS
boundary "card.html\n(КарточкаЗаявки)" as UI
control "card()" as C
entity "Заявка" as AP
KS -> UI : открыть заявку
UI -> C : GET /app/<id>
C -> AP : получить(id) с клиентом и продуктом
C --> UI : анкета, сведения БКИ, оценка, факторы
KS -> UI : решение, сумма, обоснование
UI -> C : POST /app/<id>
alt решение ≠ рекомендации и обоснование < 20 символов
  C --> UI : «напишите обоснование»
else иначе
  C -> AP : состояние, сумма, обоснование, дата решения
  C --> UI : «Решение сохранено»
end
@enduml
