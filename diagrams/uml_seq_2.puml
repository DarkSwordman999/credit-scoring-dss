@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Кредитный специалист" as KS
boundary "КарточкаЗаявки" as UI
control "КонтроллерЗаявок" as C
entity "Заявка" as AP
entity "Документ" as D
participant "Хранилище файлов" as FS
entity "ЖурналАудита" as AU
KS -> UI : выбрать вид документа и файл
UI -> C : прикрепить(заявка, вид, файл)
C -> AP : доступныеДействия(роль, статус)
alt прикрепление недоступно в этом состоянии
  C --> UI : 409 «В этом состоянии документы не прикрепляются»
else доступно
  C -> C : проверитьФайл() [PDF, JPG, PNG, не более 20 МБ, не пустой]
  alt файл не прошёл проверку
    C --> UI : ошибка формата или размера
  else файл корректен
    C -> FS : сохранить под случайным именем
    C -> D : создать(вид, имя, тип, размер, кто прикрепил)
    C -> AU : записать(прикреплён документ)
    C --> UI : обновлённый список документов
  end
end
KS -> UI : удалить ошибочный документ
UI -> C : удалитьДокумент(заявка, документ)
C -> C : проверитьСтатус() [Черновик или Требуются документы]
C -> FS : удалить файл
C -> D : удалить()
C -> AU : записать(удалён документ)
@enduml
