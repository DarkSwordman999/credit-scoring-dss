@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam linetype ortho
entity "Клиент" as cl {
 * id_клиента
 --
 ФИО
 дата_рождения
 паспорт (серия, номер)
 адрес_регистрации
 телефон, e_mail
}
entity "Занятость" as emp {
 * id_занятости
 --
 id_клиента (FK)
 работодатель
 должность
 стаж_мес
 доход_подтверждённый
}
entity "Кредитный_продукт" as pr {
 * id_продукта
 --
 наименование
 мин/макс сумма
 мин/макс срок
 базовая_ставка
}
entity "Заявка" as ap {
 * id_заявки
 --
 id_клиента (FK)
 id_продукта (FK)
 сумма, срок, цель
 канал, дата
 статус
}
entity "Согласие" as cs {
 * id_согласия
 --
 id_заявки (FK)
 вид (ПДн / запрос в БКИ)
 дата, срок_действия
}
entity "Кредитный_отчёт" as cr {
 * id_отчёта
 --
 id_заявки (FK)
 дата_получения
 число_кредитов
 текущая_задолженность
 ежемес_платежи
 макс_просрочка_дн
 запросов_за_6_мес
}
entity "Версия_методики" as md {
 * id_версии
 --
 версия, наименование
 баллы_характеристик
 ROC_AUC, Gini, KS
 статус, даты
}
entity "Результат_скоринга" as sr {
 * id_результата
 --
 id_заявки (FK)
 id_версии (FK)
 PD, скоринговый_балл
 класс_риска, ПДН
 вклад_факторов
}
entity "Стоп_фактор" as sf {
 * id_стоп_фактора
 --
 код, описание
 условие, активен
}
entity "Решение" as dc {
 * id_решения
 --
 id_заявки (FK)
 id_сотрудника (FK)
 рекомендация
 итог, сумма, ставка
 комментарий, дата
}
entity "Кредит" as ln {
 * id_кредита
 --
 id_заявки (FK)
 номер_договора
 дата_выдачи, сумма
 ставка, состояние
 макс_просрочка_12_мес
}
entity "Сотрудник" as us {
 * id_сотрудника
 --
 ФИО, роль
 лимит_полномочий
}
cl ||--o{ emp
cl ||--o{ ap
pr ||--o{ ap
ap ||--|{ cs
ap ||--o| cr
ap ||--o{ sr
md ||--o{ sr
sr }o--o{ sf : сработал
ap ||--o{ dc
us ||--o{ dc
ap ||--o| ln
@enduml
