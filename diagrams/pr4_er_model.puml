@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam linetype ortho
entity "users\nПользователь" as us {
 * id : INTEGER
 --
 login : TEXT (уник.)
 password_hash : TEXT
}
entity "products\nКредитный продукт" as pr {
 * id : INTEGER
 --
 name : TEXT (уник.)
 min_amount, max_amount : REAL
 min_term, max_term : INTEGER
 rate : REAL
}
entity "clients\nКлиент" as cl {
 * id : INTEGER
 --
 last_name, first_name, middle_name : TEXT
 birth_date : TEXT
 passport : TEXT (уник.)
 phone : TEXT
}
entity "applications\nЗаявка" as ap {
 * id : INTEGER
 --
 client_id : INTEGER (FK)
 product_id : INTEGER (FK)
 created_at : TEXT
 amount, term, income, experience
 .. сведения из кредитного отчёта ..
 payments, max_dpd, current_dpd
 inquiries, history_months
 .. оценка ..
 score, pd, risk_class, pdn
 stop_factor, factors (JSON)
 recommendation, rec_amount, rec_rate
 .. решение ..
 status, approved_amount
 comment, decided_at
}
cl ||--o{ ap
pr ||--o{ ap
@enduml
