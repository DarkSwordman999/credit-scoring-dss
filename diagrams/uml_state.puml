@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
[*] --> Черновик
Черновик --> Зарегистрирована : сохранить [согласия получены]
Зарегистрирована --> СборДанных : запустить проверку
СборДанных --> Скоринг : досье сформировано
СборДанных --> ТребуютсяДокументы : данные не подтверждены
ТребуютсяДокументы --> СборДанных : документы получены
Скоринг --> НаРассмотрении : оценка рассчитана
НаРассмотрении --> НаКредитномКомитете : сумма > лимита
НаРассмотрении --> Одобрена : одобрить
НаРассмотрении --> Отклонена : отказать
НаКредитномКомитете --> Одобрена : утвердить
НаКредитномКомитете --> Отклонена : отклонить
Одобрена --> Выдана : договор подписан
Одобрена --> ОтказКлиента : клиент отказался
Выдана --> [*]
Отклонена --> [*]
ОтказКлиента --> [*]
state Скоринг {
  [*] --> ПроверкаСтопФакторов
  ПроверкаСтопФакторов --> РасчётБаллаИPD : нет стоп-факторов
  РасчётБаллаИPD --> ФормированиеРекомендации
  ПроверкаСтопФакторов --> ФормированиеРекомендации : стоп-фактор
  ФормированиеРекомендации --> [*]
}
@enduml
