@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
[*] --> Оценка : заявка введена\n[проверки пройдены]
state Оценка {
  [*] --> ПроверкаСтопФакторов
  ПроверкаСтопФакторов --> РасчётБаллаИPD : нет стоп-факторов
  РасчётБаллаИPD --> ФормированиеРекомендации
  ПроверкаСтопФакторов --> ФормированиеРекомендации : стоп-фактор
  ФормированиеРекомендации --> [*]
}
Оценка --> НаРассмотрении : оценка сохранена
НаРассмотрении --> Одобрена : одобрить\n[обоснование, если ≠ рекомендации]
НаРассмотрении --> Отклонена : отказать\n[обоснование, если ≠ рекомендации]
Одобрена --> [*]
Отклонена --> [*]
@enduml
