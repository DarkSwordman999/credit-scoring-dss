@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Руководитель отдела" as HD
boundary "РеестрЗаёмщиков" as UI
control "СервисПортфеля" as P
entity "Клиент" as CL
entity "Заявка" as AP
entity "Кредит" as LN
entity "КредитныйОтчёт" as CR
entity "РезультатСкоринга" as R
entity "ЖурналАудита" as AU
boundary "ЭкранПортфеля" as LP
HD -> UI : отбор: фамилия, паспорт, «с кредитами», «с просрочкой»
UI -> P : реестр(отбор, страница)
P -> CL : выбрать(отбор)
P -> AP : итогиПоКлиентам() [заявок, одобрено, отклонено]
P -> LN : итогиПоКлиентам() [задолженность, просрочка]
P --> UI : реестр заёмщиков
HD -> UI : открыть карточку клиента
UI -> P : карточка(клиент)
P -> CR : получить(клиент)
P -> AU : записать(просмотр карточки клиента)
P --> UI : данные, доход, история, заявки, кредиты
HD -> LP : открыть «Кредитный портфель»
LP -> P : портфель(статус, период, отбор)
P -> LN : выбрать(отбор)
P -> R : последнийПоЗаявке(кредиты) [коррелированный подзапрос]
P -> P : качествоПоКлассам() [средний PD и доля дефолтов]
P --> LP : кредиты и качество портфеля
@enduml
