@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
skinparam rectangle {
 BorderColor black
}
actor "Риск-аналитик" as RA
rectangle ":ЭкранМетодики\n«boundary»" as UI
rectangle ":СервисМетодики\n«control»" as T
rectangle ":ВерсияМетодики\n«entity»" as M
rectangle ":Кредит\n«entity»" as LN
rectangle ":РезультатСкоринга\n«entity»" as R
rectangle ":РасчётМетрик\n«control»" as MT
rectangle ":ЖурналАудита\n«entity»" as AU
RA -- UI : "1: создать версию на основе\nвыбранной ↓\n4: изменить баллы характеристик\nи границы интервалов ↓\n9: проверить на истории (период\nвыдачи) ↓"
UI -- T : "2: создатьКандидата(исходная) ↓\n5: изменитьКандидата(версия,\nпараметры) ↓\n7: [есть ошибки в параметрах]\nсписок ошибок ↑\n10: проверить(версия, период) ↓\n13: [мало кредитов или дефолтов]\n«Недостаточный объём данных» ↑\n17: [выборка достаточна] метрики\nкандидата и действующей версии ↑"
T -- M : "3: создать(копия параметров,\nстатус = Кандидат) ↓\n8: [параметры корректны]\nsetПараметры() ↓\n15: [выборка достаточна]\nsetМетрики() ↓"
T -- T : "6: проверитьПараметры()"
T -- LN : "11: созревшие(период) [выданы ≥\n12 мес. назад] ↓"
T -- R : "12: признакиПриВыдаче(кредиты) ↓"
T -- MT : "14: [выборка достаточна]\nметрики(кандидат, действующая)\n[ROC AUC, Gini, KS] ↓"
T -- AU : "16: [выборка достаточна]\nзаписать(проверка версии) ↓"
@enduml
