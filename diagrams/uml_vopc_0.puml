@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ФормаЗаявки <<boundary>> {
 +показать(продукты)
 +показатьОшибки()
}
class ОбработчикНовойЗаявки <<control>> {
 +new_application()
 -проверитьДанные(): список ошибок
}
class ОценкаЗаявки <<control>> {
 +evaluate(анкета, продукт): Оценка
}
class Продукт <<entity>> {
 наименование
 диапазоны суммы и срока
 ставка
}
class Клиент <<entity>> {
 ФИО
 датаРождения
 паспорт
 телефон
}
class Заявка <<entity>> {
 сумма, срок, доход, стаж
 сведения БКИ
 оценка
 состояние
}
ФормаЗаявки --> ОбработчикНовойЗаявки
ОбработчикНовойЗаявки --> Продукт
ОбработчикНовойЗаявки --> Клиент
ОбработчикНовойЗаявки --> ОценкаЗаявки
ОбработчикНовойЗаявки --> Заявка
Клиент "1" -- "0..*" Заявка
Продукт "1" -- "0..*" Заявка
@enduml
