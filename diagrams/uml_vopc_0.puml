@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
class ФормаЗаявки <<boundary>> {
 +ввестиАнкету()
 +прикрепитьДокумент()
 +показатьОшибки()
}
class КонтроллерЗаявок <<control>> {
 +создатьЗаявку(анкета)
 -проверитьДанные(): bool
}
class АдаптерБКИ <<control>> {
 +запроситьОтчёт(заявка)
 -разобратьОтвет()
}
class Клиент <<entity>> {
 ФИО
 паспорт
 датаРождения
 +найтиИлиСоздать()
}
class Заявка <<entity>> {
 номер
 сумма
 срок
 статус
 +setСтатус()
}
class Согласие <<entity>> {
 вид
 дата
}
class КредитныйОтчёт <<entity>> {
 датаПолучения
 задолженность
 просрочки
}
ФормаЗаявки --> КонтроллерЗаявок
КонтроллерЗаявок --> Клиент
КонтроллерЗаявок --> Заявка
КонтроллерЗаявок --> АдаптерБКИ
Клиент "1" -- "0..*" Заявка
Заявка "1" *-- "1..*" Согласие
Заявка "1" -- "0..1" КредитныйОтчёт
АдаптерБКИ --> КредитныйОтчёт
@enduml
