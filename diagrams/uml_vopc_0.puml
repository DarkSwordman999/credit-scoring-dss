@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
class ФормаВхода <<boundary>> {
 +ввестиЛогинПароль()
}
class КонтроллерВхода <<control>> {
 +получитьТокен(логин, пароль)
 -проверитьХэшПароля()
 -выпуститьТокен(сотрудник, роль, срок)
}
class Сотрудник <<entity>> {
 {field} login: строка(64)
 {field} full_name: строка(200)
 {field} role: строка(32)
 {field} limit_amount: деньги
 {field} active: логическое
 --
 +найти(логин)
}
class ЖурналАудита <<entity>> {
 {field} user_login: строка(64)
 {field} action: строка(200)
 {field} entity: строка(50)
 {field} changes: JSON
 --
 +записать(вход в систему)
}
ФормаВхода --> КонтроллерВхода
КонтроллерВхода --> Сотрудник
КонтроллерВхода --> ЖурналАудита
@enduml
