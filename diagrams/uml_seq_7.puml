@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Руководитель отдела" as HD
boundary "КарточкаЗаявки" as UI
control "КонтроллерРешений" as C
entity "Решение" as D
entity "РезультатСкоринга" as R
entity "Сотрудник" as E
entity "Заявка" as AP
control "Уведомитель" as N
entity "ЖурналАудита" as AU
HD -> UI : открыть заявку из очереди комитета
UI -> C : карточка(заявка)
C -> D : история(заявка)
C -> R : последний(заявка)
C --> UI : досье, оценка, предложение андеррайтера
HD -> UI : решение комитета, условия, комментарий
UI -> C : решениеКомитета(заявка, решение)
C -> C : проверитьУсловия(), проверитьКомментарий()
C -> E : лимитПолномочий()
alt сумма больше лимита руководителя
  C --> UI : «Сумма превышает и ваш лимит полномочий»
else проверки пройдены
  C -> D : создать(этап комитет, итог, условия)
  C -> AP : setСтатус(Одобрена / Отклонена)
  C -> N : уведомитьКлиента(заявка, решение)
  C -> AU : записать(кредитный комитет)
  C --> UI : решение сохранено
end
@enduml
