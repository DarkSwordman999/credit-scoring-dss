@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
class КарточкаЗаявки <<boundary>> {
 +запроситьДокументы()
 +прикрепитьПолученныеДокументы()
 +вернутьРассмотрение()
}
class КонтроллерРешений <<control>> {
 +решить(заявка, docs, комментарий)
}
class Решение <<entity>> {
 {field} stage: строка(20)
 {field} recommendation: строка(20)
 {field} outcome: строка(20)
 {field} amount: деньги
 {field} term_months: целое
 {field} rate: дробное
 --
 +создать(итог = docs, комментарий)
}
class Заявка <<entity>> {
 {field} number: строка(30)
 {field} amount: деньги
 {field} term_months: целое
 {field} purpose: строка(200)
 {field} channel: строка(20)
 {field} marital_status: строка(20)
 --
 +setСтатус(...)
}
class КонтроллерЗаявок <<control>> {
 +прикрепить(заявка, файл)
 +вернутьНаРассмотрение(заявка)
}
class Документ <<entity>> {
 {field} kind: строка(50)
 {field} filename: строка(255)
 {field} content_type: строка(100)
 {field} size: целое
 {field} stored_name: строка(100)
 {field} uploaded_at: дата и время
 --
 +создать()
}
class СервисДосье <<control>> {
 +выполнитьСкоринг(заявка)
}
КарточкаЗаявки --> КонтроллерРешений
КонтроллерРешений --> Решение
КонтроллерРешений --> Заявка
КарточкаЗаявки --> КонтроллерЗаявок
КонтроллерЗаявок --> Документ
КонтроллерЗаявок --> Заявка
КонтроллерЗаявок --> СервисДосье
Заявка "1" -- "0..*" Документ
Заявка "1" -- "0..*" Решение
@enduml
