@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
hide circle
skinparam classAttributeIconSize 0
skinparam wrapWidth 260
class КарточкаЗаявки <<boundary>> {
 +выбратьВидДокумента()
 +удалитьОшибочныйДокумент()
 +открытьЗаявкуОчереди()
 +пересчитатьОценку()
 +выбратьРешение()
 +запроситьДокументы()
 +прикрепитьПолученныеДокументы()
 +вернутьРассмотрение()
 +решениеКомитета()
 +кредитВыдан()
 +отказКлиента()
}
class РеестрЗаёмщиков <<boundary>> {
 +отбор()
 +открытьКарточкуКлиента()
}
class ФормаВхода <<boundary>> {
 +ввестиЛогинПароль()
}
class ФормаЗаявки <<boundary>> {
 +ввестиСериюНомер()
 +заполнитьАнкету()
 +зарегистрировать()
}
class ШлюзАБС <<boundary>> {
 +принятьСведения(пакет)
 -проверитьКлюч()
 -добавитьВНенайденные()
}
class ЭкранАдминистрирования <<boundary>> {
 +добавитьПользователя()
 +изменитьРоль()
 +изменитьПараметрыСистемы()
 +журналАудита()
 +журналОбменаБКИ()
 +создатьКопиюСейчас()
 +скачатьКопию()
}
class ЭкранМетодики <<boundary>> {
 +создатьВерсиюОснове()
 +изменитьБаллыХарактеристик()
 +проверитьИстории()
 +отправитьУтверждение()
 +утвердитьОтклонитьПричиной()
 +опубликовать()
 +откатитьсяАрхивнуюВерсию()
 +открытьМониторинг()
 +рассчитатьМесяцГГГГ()
}
class ЭкранОтчётов <<boundary>> {
 +выбратьВидОтчёта()
 +выгрузитьXLSXPDF()
}
class ЭкранПортфеля <<boundary>> {
 +открытьКредитныйПортфель()
}
class ЭкранСправочников <<boundary>> {
 +изменитьСтопФактор()
 +изменитьПорогиКлассов()
 +добавитьКредитныйПродукт()
 +добавитьЗаписьВнутренний()
}
КарточкаЗаявки -[hidden]down- ФормаЗаявки
РеестрЗаёмщиков -[hidden]down- ШлюзАБС
ФормаВхода -[hidden]down- ЭкранАдминистрирования
ФормаЗаявки -[hidden]down- ЭкранМетодики
ШлюзАБС -[hidden]down- ЭкранОтчётов
ЭкранАдминистрирования -[hidden]down- ЭкранПортфеля
ЭкранМетодики -[hidden]down- ЭкранСправочников
@enduml
