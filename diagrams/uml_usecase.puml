@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
skinparam packageStyle rectangle
actor "Кредитный\nспециалист" as KS
actor "Андеррайтер" as UW
actor "Руководитель\nотдела" as HD
actor "Риск-аналитик" as RA
actor "Администратор" as AD
actor "Время" as TM
actor "БКИ" as BKI <<system>>
actor "АБС" as ABS <<system>>
rectangle "СППР оценки кредитоспособности" {
  usecase "Войти в систему" as U0
  usecase "Зарегистрировать\nзаявку" as U1
  usecase "Прикрепить\nдокументы клиента" as U2
  usecase "Собрать кредитное\nдосье" as U3
  usecase "Выполнить скоринг\nзаявки" as U5
  usecase "Принять решение\nпо заявке" as U6
  usecase "Запросить\nдополнительные документы" as U7
  usecase "Утвердить решение\nкредитным комитетом" as U8
  usecase "Оформить выдачу\nили отказ клиента" as U9
  usecase "Подготовить и проверить\nверсию методики" as U10
  usecase "Утвердить и опубликовать\nверсию методики" as U11
  usecase "Мониторить качество\nметодики" as U12
  usecase "Принять сведения\nоб обслуживании кредитов" as U13
  usecase "Сформировать отчёт" as U14
  usecase "Просмотреть заёмщиков\nи кредитный портфель" as U15
  usecase "Вести справочники\nкредитной политики" as U16
  usecase "Управлять пользователями,\nпараметрами и журналами" as U17
  usecase "Создать резервную копию\nи восстановить БД" as U19
}
KS --> U1
KS --> U2
KS --> U9
UW --> U6
HD --> U8
RA --> U10
HD --> U11
RA --> U11
RA --> U12
TM --> U12
HD --> U14
RA --> U14
HD --> U15
UW --> U15
RA --> U16
AD --> U16
AD --> U17
AD --> U19
TM --> U19
U1 ..> U3 : <<include>>
U3 ..> U5 : <<include>>
U7 .> U6 : <<extend>>
U8 .> U6 : <<extend>>
U3 --> BKI
U3 --> ABS
U9 --> ABS
ABS --> U13
@enduml
