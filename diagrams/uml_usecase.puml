@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
left to right direction
actor "Специалист\nпо займам" as KS
actor "Руководитель\nОрганизации" as HD
rectangle "Кредитный скоринг Базовая" {
  usecase "Войти в систему" as U0
  usecase "Зарегистрировать\nи оценить заявку" as U1
  usecase "Рассчитать оценку" as U2
  usecase "Просмотреть список\nзаявок" as U3
  usecase "Просмотреть заявку,\nоценку и факторы" as U4
  usecase "Принять решение" as U5
  usecase "Сформировать отчёт\nпо классам риска" as U6
  usecase "Вести справочник\nпродуктов" as U7
}
HD --|> KS
KS --> U1
KS --> U3
KS --> U4
KS --> U5
HD --> U6
HD --> U7
U1 ..> U2 : <<include>>
U5 ..> U4 : <<include>>
U1 ..> U0 : <<include>>
U3 ..> U0 : <<include>>
U6 ..> U0 : <<include>>
@enduml
