@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
skinparam monochrome true
actor "Риск-аналитик" as RA
boundary "ЭкранМетодики" as UI
control "СервисМетодики" as T
entity "ВерсияМетодики" as M
entity "Кредит" as LN
entity "РезультатСкоринга" as R
control "РасчётМетрик" as MT
entity "ЖурналАудита" as AU
RA -> UI : создать версию на основе выбранной
UI -> T : создатьКандидата(исходная)
T -> M : создать(копия параметров, статус = Кандидат)
RA -> UI : изменить баллы характеристик и границы интервалов
UI -> T : изменитьКандидата(версия, параметры)
T -> T : проверитьПараметры()
alt есть ошибки в параметрах
  T --> UI : список ошибок
else параметры корректны
  T -> M : setПараметры()
end
RA -> UI : проверить на истории (период выдачи)
UI -> T : проверить(версия, период)
T -> LN : созревшие(период) [выданы ≥ 12 мес. назад]
T -> R : признакиПриВыдаче(кредиты)
alt мало кредитов или дефолтов
  T --> UI : «Недостаточный объём данных»
else выборка достаточна
  T -> MT : метрики(кандидат, действующая) [ROC AUC, Gini, KS]
  T -> M : setМетрики()
  T -> AU : записать(проверка версии)
  T --> UI : метрики кандидата и действующей версии
end
@enduml
