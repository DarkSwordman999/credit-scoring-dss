# Скопируйте в .env и задайте свои значения
DB_PASSWORD=смените-пароль-бд
# ключ, которым backend-api подписывает запросы к сервису скоринга
SCORING_KEY=смените-ключ-сервиса-скоринга
# ключ подписи токенов входа; пусто — создаётся случайный и хранится в /data/secret.key
SECRET_KEY=
ADMIN_PASSWORD=admin
HTTP_PORT=8080

# HTTPS (Б-1): домен сервера; запуск — docker compose --profile https up -d
DOMAIN=scoring.bank.local

# ключ, с которым АБС передаёт сведения об обслуживании кредитов (X-API-Key)
ABS_API_KEY=abs-demo-key

# вход через Active Directory / LDAP (пусто — локальные учётные записи)
LDAP_URL=
LDAP_DOMAIN=

# готовые образы из GitHub Container Registry вместо локальной сборки:
# IMAGE_PREFIX=ghcr.io/darkswordman999/credit-scoring-dss
# TAG=1.0.0
