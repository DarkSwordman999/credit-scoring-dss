# backend-api, scoring-service и scheduler (один образ, разные команды)
FROM python:3.12-slim
LABEL org.opencontainers.image.source="https://github.com/DarkSwordman999/credit-scoring-dss" \
      org.opencontainers.image.description="СППР «Кредитный скоринг»: backend-api, сервис скоринга, планировщик" \
      org.opencontainers.image.licenses="LicenseRef-Noncommercial"

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    CREDITDSS_DATA_DIR=/data TZ=Europe/Moscow

RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY LICENSE ./
COPY backend/pyproject.toml ./
COPY backend/creditdss ./creditdss
RUN pip install .

RUN useradd -r -u 1000 credit && mkdir -p /data && chown credit /data
USER credit
VOLUME /data
EXPOSE 8000 8001

# миграции применяются при старте; планировщик и сервис скоринга — отдельными сервисами
CMD ["sh", "-c", "creditdss init-db --admin-password \"${CREDITDSS_ADMIN_PASSWORD:-admin}\" && exec uvicorn creditdss.main:app --host 0.0.0.0 --port 8000 --proxy-headers"]
